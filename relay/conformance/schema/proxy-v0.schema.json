{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/proxy.schema.json",
  "title": "PROXY header cases of the Relay Specification v0 (RELAY-v0 section 4.6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "required": [
          "id",
          "section",
          "hex",
          "expected",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "section": {
            "const": "4.6"
          },
          "hex": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$",
            "maxLength": 400
          },
          "expected": {
            "enum": [
              "accepted",
              "refused",
              "either"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "address",
              "port"
            ],
            "properties": {
              "address": {
                "type": "string",
                "maxLength": 45
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "consumed": {
            "enum": [
              28,
              52
            ]
          },
          "why": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "expected": {
              "const": "refused"
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "consumed"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "source",
            "consumed"
          ]
        },
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
