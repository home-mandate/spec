{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/caa.schema.json",
  "title": "CAA comparison cases of the Relay Specification v0 (RELAY-v0 section 6.7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "required": [
          "id",
          "section",
          "target",
          "pair",
          "minutes_since_pairing",
          "grace",
          "answers_validated",
          "resolvers",
          "expected",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "section": {
            "const": "6.7"
          },
          "target": {
            "enum": [
              "name",
              "apex"
            ]
          },
          "pair": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "caa_identity",
                  "acme_account"
                ],
                "properties": {
                  "caa_identity": {
                    "type": "string"
                  },
                  "acme_account": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "minutes_since_pairing": {
            "type": "integer",
            "minimum": 0
          },
          "grace": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "previous_pair",
                  "reported_by_gateway",
                  "minutes_since_learned"
                ],
                "properties": {
                  "previous_pair": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "caa_identity",
                          "acme_account"
                        ],
                        "properties": {
                          "caa_identity": {
                            "type": "string"
                          },
                          "acme_account": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reported_by_gateway": {
                    "type": "boolean"
                  },
                  "minutes_since_learned": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "answers_validated": {
            "type": "boolean"
          },
          "resolvers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "status",
                "chain",
                "records"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,32}$"
                },
                "status": {
                  "enum": [
                    "ok",
                    "nxdomain",
                    "servfail",
                    "refused",
                    "formerr",
                    "timeout",
                    "truncated",
                    "unparsable"
                  ]
                },
                "chain": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "at"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "CNAME",
                          "DNAME"
                        ]
                      },
                      "at": {
                        "enum": [
                          "name",
                          "ancestor"
                        ]
                      }
                    }
                  }
                },
                "records": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "flags",
                      "tag",
                      "value"
                    ],
                    "properties": {
                      "flags": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "tag": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]{1,15}$"
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 512
                      }
                    }
                  }
                }
              }
            }
          },
          "expected": {
            "enum": [
              "difference",
              "prescribed"
            ]
          },
          "successful_round": {
            "type": "boolean"
          },
          "why": {
            "type": "string"
          }
        },
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
