{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/binding.schema.json",
  "title": "Data connection binding cases of the Relay Specification v0 (RELAY-v0 section 4.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tokens",
          "control_not_before",
          "limit_reached",
          "connection",
          "first_bytes",
          "expected",
          "consumed",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "token",
                "installation",
                "state"
              ],
              "properties": {
                "token": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "installation": {
                  "type": "string",
                  "pattern": "^[a-z2-7]{26}$"
                },
                "state": {
                  "enum": [
                    "open",
                    "used",
                    "withdrawn",
                    "expired"
                  ]
                }
              }
            }
          },
          "control_not_before": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "limit_reached": {
            "type": "boolean"
          },
          "connection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "installation",
              "not_before"
            ],
            "properties": {
              "installation": {
                "type": "string",
                "pattern": "^[a-z2-7]{26}$"
              },
              "not_before": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          },
          "first_bytes": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$",
            "minLength": 8
          },
          "expected": {
            "enum": [
              "bound",
              "closed"
            ]
          },
          "consumed": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
