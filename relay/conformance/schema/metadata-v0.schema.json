{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/metadata.schema.json",
  "title": "Operator metadata cases of the Relay Specification v0 (RELAY-v0 section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "host",
          "expected",
          "why"
        ],
        "oneOf": [
          {
            "required": [
              "document"
            ]
          },
          {
            "required": [
              "document_raw"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "host": {
            "type": "string",
            "description": "The host the document was fetched from: https://<host>/.well-known/home-mandate-relay."
          },
          "document": {
            "type": "object",
            "description": "The document; its size is that of this object in any compact encoding, well below 16 KiB."
          },
          "document_raw": {
            "type": "string",
            "description": "The exact bytes of the document, in UTF-8: for documents that cannot be written inline (duplicate members, sizes at the limit, not an object)."
          },
          "expected": {
            "enum": [
              "valid",
              "invalid"
            ]
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
