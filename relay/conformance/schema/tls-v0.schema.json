{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/tls.schema.json",
  "title": "TLS probes of tunnel connections of the Relay Specification v0 (RELAY-v0 sections 4.1, 4.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "client",
          "expected",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "client": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "groups",
              "alpn",
              "certificate",
              "resume"
            ],
            "properties": {
              "version": {
                "enum": [
                  "1.2",
                  "1.3"
                ]
              },
              "groups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "X25519MLKEM768",
                    "x25519",
                    "secp256r1"
                  ]
                }
              },
              "alpn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "certificate": {
                "enum": [
                  "tunnel",
                  "tunnel-p256",
                  "none",
                  "self-signed",
                  "unpaired"
                ]
              },
              "resume": {
                "type": "boolean"
              }
            }
          },
          "expected": {
            "enum": [
              "accepted",
              "refused"
            ]
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
