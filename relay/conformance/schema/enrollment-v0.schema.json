{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/enrollment.schema.json",
  "title": "Enrollment order cases of the Relay Specification v0 (RELAY-v0 section 5.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "world",
          "offline",
          "why",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "world": {
            "description": "What the operator holds before the case. both-active: two installations of the test account; other-unpaired: the second one unpaired; blocked, offline, offline-blocked: the installation under test is blocked, has been offline for longer than max_offline_days, or both.",
            "enum": [
              "both-active",
              "other-unpaired",
              "blocked",
              "offline",
              "offline-blocked"
            ]
          },
          "offline": {
            "description": "true: the case is played offline only, against the reference operator; a live test cannot bring an operator into this state (RELAY-v0 section 8.3).",
            "type": "boolean"
          },
          "why": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kid",
                "to",
                "header",
                "nonce",
                "signature",
                "alg",
                "payload",
                "expect"
              ],
              "properties": {
                "kid": {
                  "enum": [
                    "self",
                    "unpaired",
                    "unknown",
                    "none"
                  ]
                },
                "to": {
                  "enum": [
                    "self",
                    "other",
                    "unpaired",
                    "unknown",
                    "pair",
                    "key-change",
                    "certificate"
                  ]
                },
                "header": {
                  "description": "The url of the protected header: the URL the request is sent to, or a different valid URL.",
                  "enum": [
                    "same",
                    "different"
                  ]
                },
                "nonce": {
                  "enum": [
                    "fresh",
                    "used",
                    "unknown",
                    "previous"
                  ]
                },
                "signature": {
                  "enum": [
                    "valid",
                    "foreign"
                  ]
                },
                "alg": {
                  "enum": [
                    "key",
                    "other"
                  ]
                },
                "payload": {
                  "enum": [
                    "none",
                    "csr",
                    "extra-member",
                    "not-object",
                    "duplicate-member",
                    "noop",
                    "unpair"
                  ]
                },
                "expect": {
                  "enum": [
                    "ok",
                    "malformed",
                    "bad-nonce",
                    "bad-signature",
                    "unpaired",
                    "blocked",
                    "offline-too-long"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
