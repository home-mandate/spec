{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/pairing.schema.json",
  "title": "Pairing string cases of the Relay Specification v0 (RELAY-v0 section 5.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "required": [
          "id",
          "section",
          "input",
          "expected",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "section": {
            "const": "5.2"
          },
          "input": {
            "type": "string",
            "maxLength": 400
          },
          "expected": {
            "oneOf": [
              {
                "const": "invalid"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operator_domain",
                  "code"
                ],
                "properties": {
                  "operator_domain": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z2-7]{16}$"
                  }
                }
              }
            ]
          },
          "why": {
            "type": "string"
          }
        },
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
