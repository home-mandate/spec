{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/manifest.schema.json",
  "title": "Manifest of the machine-readable files of the Relay Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "files"
  ],
  "properties": {
    "spec": {
      "const": "relay-v0"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^relay/[a-z0-9._/-]*[.]json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the file's bytes."
          },
          "cases": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of cases; conformance files only."
          }
        }
      }
    }
  }
}
