{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/destination.schema.json",
  "title": "Destination cases of the Relay Specification v0 (RELAY-v0 section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "required": [
          "id",
          "section",
          "address",
          "expected",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "section": {
            "const": "3"
          },
          "address": {
            "type": "string",
            "maxLength": 64
          },
          "expected": {
            "enum": [
              "allow",
              "refuse"
            ]
          },
          "why": {
            "type": "string"
          }
        },
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
