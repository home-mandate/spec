{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/relay-conformance/v0/ct.schema.json",
  "title": "Certificate Transparency monitoring cases of the Relay Specification v0 (RELAY-v0 section 6.7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "required": [
          "id",
          "section",
          "public_names",
          "pairing",
          "now",
          "server_keys",
          "acknowledged",
          "certificates",
          "expected",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "section": {
            "const": "6.7"
          },
          "public_names": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 253
            }
          },
          "pairing": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "now": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "server_keys": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "earlier"
            ],
            "properties": {
              "current": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
              },
              "earlier": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "public_key",
                    "replaced"
                  ],
                  "properties": {
                    "public_key": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
                    },
                    "replaced": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                    }
                  }
                }
              }
            }
          },
          "acknowledged": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
            },
            "uniqueItems": true
          },
          "certificates": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "digest",
                "names",
                "not_before",
                "not_after",
                "public_key",
                "logged"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]{1,8}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
                },
                "names": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "maxLength": 253
                  }
                },
                "not_before": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "not_after": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "public_key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
                },
                "logged": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              }
            }
          },
          "expected": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]{1,8}$"
                },
                "result": {
                  "enum": [
                    "alarm",
                    "past-exposure",
                    "none"
                  ]
                }
              }
            }
          },
          "why": {
            "type": "string"
          }
        },
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
