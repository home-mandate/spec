{
  "description": "Pairing strings of the Relay Specification v0 (draft), RELAY-v0.md section 5.2 ($defs/pairing_string in relay/schema/enrollment-v0.schema.json). Each case: the string a person typed or a QR code held, and whether a gateway accepts it before it sends any request; if it does, the operator domain and the code as the gateway uses them (the code in upper case without hyphens). The string is taken as it is: a gateway does not remove white space or change case. Every accepted string matches the pattern of the schema, and a refused one does not, except those whose domain is longer than 253 characters, which the schema's maxLength admits. The strings are hostile on purpose; print them only with an escaping function.",
  "cases": [
    {"id": "p01", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "the form the portal shows"},
    {"id": "p02", "section": "5.2", "input": "relay-operator.example/ABCDEFGHIJKLMNOP", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "without hyphens"},
    {"id": "p03", "section": "5.2", "input": "relay-operator.example/abcd-efgh-ijkl-mnop", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "lower-case code is accepted and sent in upper case"},
    {"id": "p04", "section": "5.2", "input": "relay-operator.example/AbCd-eFgH-IjKl-MnOp", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "mixed case"},
    {"id": "p05", "section": "5.2", "input": "relay-operator.example/ABCD-EFGHIJKLMNOP", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "only the first of the three hyphens"},
    {"id": "p06", "section": "5.2", "input": "relay-operator.example/ABCDEFGH-IJKLMNOP", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "only the second hyphen"},
    {"id": "p07", "section": "5.2", "input": "relay-operator.example/ABCDEFGHIJKL-MNOP", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "only the third hyphen"},
    {"id": "p08", "section": "5.2", "input": "relay-operator.example/ABCD-EFGHIJKL-MNOP", "expected": {"operator_domain": "relay-operator.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "the first and the third hyphen"},
    {"id": "p09", "section": "5.2", "input": "relay-operator.example/A2C3-E4G5-I6K7-MNOP", "expected": {"operator_domain": "relay-operator.example", "code": "A2C3E4G5I6K7MNOP"}, "why": "the digits 2 to 7"},
    {"id": "p10", "section": "5.2", "input": "a.b.c.example/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "a.b.c.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "several labels"},
    {"id": "p11", "section": "5.2", "input": "xn--bcher-kva.example/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "xn--bcher-kva.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "an A-label is not decoded or checked"},
    {"id": "p12", "section": "5.2", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "a label of 63 characters"},
    {"id": "p13", "section": "5.2", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/ABCDEFGHIJKLMNOP", "expected": {"operator_domain": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "code": "ABCDEFGHIJKLMNOP"}, "why": "a domain of 253 characters"},
    {"id": "p14", "section": "5.2", "input": "1password.example/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "1password.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "a label that begins with a digit"},
    {"id": "p15", "section": "5.2", "input": "a--b.example/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "a--b.example", "code": "ABCDEFGHIJKLMNOP"}, "why": "two hyphens inside a label"},
    {"id": "p16", "section": "5.2", "input": "example.co-op/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "example.co-op", "code": "ABCDEFGHIJKLMNOP"}, "why": "a hyphen in the last label"},
    {"id": "p17", "section": "5.2", "input": "a.b/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "a.b", "code": "ABCDEFGHIJKLMNOP"}, "why": "the shortest domain: two labels of one character"},
    {"id": "p18", "section": "5.2", "input": "xn--zzzzzz.xn--p1ai/ABCD-EFGH-IJKL-MNOP", "expected": {"operator_domain": "xn--zzzzzz.xn--p1ai", "code": "ABCDEFGHIJKLMNOP"}, "why": "A-labels that are not valid Punycode are not decoded"},
    {"id": "p20", "section": "5.2", "input": "Relay-Operator.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "upper case in the domain"},
    {"id": "p21", "section": "5.2", "input": "RELAY-OPERATOR.EXAMPLE/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "domain in upper case"},
    {"id": "p22", "section": "5.2", "input": "localhost/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a single label"},
    {"id": "p23", "section": "5.2", "input": "192.0.2.1/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "an IPv4 address"},
    {"id": "p24", "section": "5.2", "input": "[2001:db8::1]/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "an IPv6 address"},
    {"id": "p25", "section": "5.2", "input": "relay-operator.example:8443/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a port"},
    {"id": "p26", "section": "5.2", "input": "user@relay-operator.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "userinfo"},
    {"id": "p27", "section": "5.2", "input": "relay-operator.example./ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a dot at the end"},
    {"id": "p28", "section": "5.2", "input": "relay_operator.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "an underscore in a label"},
    {"id": "p29", "section": "5.2", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a label of 64 characters"},
    {"id": "p30", "section": "5.2", "input": "-relay.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a label that begins with a hyphen"},
    {"id": "p31", "section": "5.2", "input": "relay-.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a label that ends with a hyphen"},
    {"id": "p32", "section": "5.2", "input": "relay..example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "an empty label"},
    {"id": "p33", "section": "5.2", "input": ".relay.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a dot at the start"},
    {"id": "p34", "section": "5.2", "input": "relay-operator.exampleABCDEFGHIJKLMNOP", "expected": "invalid", "why": "no slash"},
    {"id": "p35", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH/IJKL-MNOP", "expected": "invalid", "why": "a second slash"},
    {"id": "p36", "section": "5.2", "input": "https://relay-operator.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a scheme before the domain"},
    {"id": "p37", "section": "5.2", "input": "relay-operator.example/path/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a path between domain and code"},
    {"id": "p38", "section": "5.2", "input": "relay-operator.123/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a last label that begins with a digit"},
    {"id": "p39", "section": "5.2", "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/ABCDEFGHIJKLMNOP", "expected": "invalid", "why": "a domain of 254 characters; the schema (maxLength 273) still admits this string"},
    {"id": "p40", "section": "5.2", "input": "bücher.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a U-label; the pairing string carries A-labels"},
    {"id": "p41", "section": "5.2", "input": "/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "no domain"},
    {"id": "p42", "section": "5.2", "input": "", "expected": "invalid", "why": "empty"},
    {"id": "p43", "section": "5.2", "input": "relay operator.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a blank inside the domain"},
    {"id": "p44", "section": "5.2", "input": " relay-operator.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "white space before; a user interface may remove it, the gateway does not"},
    {"id": "p45", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNOP ", "expected": "invalid", "why": "white space after"},
    {"id": "p46", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNOP\n", "expected": "invalid", "why": "a line feed at the end"},
    {"id": "p47", "section": "5.2", "input": "-xn.example/ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a label that begins with a hyphen"},
    {"id": "p48", "section": "5.2", "input": "ABCD-EFGH-IJKL-MNOP/relay-operator.example", "expected": "invalid", "why": "domain and code exchanged"},
    {"id": "p49", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNO0", "expected": "invalid", "why": "the digit 0 in the code"},
    {"id": "p50", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNO1", "expected": "invalid", "why": "the digit 1"},
    {"id": "p51", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNO8", "expected": "invalid", "why": "the digit 8"},
    {"id": "p52", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNO9", "expected": "invalid", "why": "the digit 9"},
    {"id": "p53", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNO", "expected": "invalid", "why": "15 characters"},
    {"id": "p54", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNOPQ", "expected": "invalid", "why": "17 characters"},
    {"id": "p55", "section": "5.2", "input": "relay-operator.example/ABC-DEFG-HIJK-LMNOP", "expected": "invalid", "why": "groups of 3, 4, 4, 5"},
    {"id": "p56", "section": "5.2", "input": "relay-operator.example/ABCDE-FGH-IJKL-MNOP", "expected": "invalid", "why": "hyphens in the wrong places"},
    {"id": "p57", "section": "5.2", "input": "relay-operator.example/ABCD--EFGH-IJKL-MNOP", "expected": "invalid", "why": "two hyphens in a row"},
    {"id": "p58", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNOP-", "expected": "invalid", "why": "a hyphen at the end"},
    {"id": "p59", "section": "5.2", "input": "relay-operator.example/-ABCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a hyphen at the start"},
    {"id": "p60", "section": "5.2", "input": "relay-operator.example/AB-CD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "four hyphens"},
    {"id": "p61", "section": "5.2", "input": "relay-operator.example/ABCD EFGH IJKL MNOP", "expected": "invalid", "why": "blanks instead of hyphens"},
    {"id": "p62", "section": "5.2", "input": "relay-operator.example/АBCD-EFGH-IJKL-MNOP", "expected": "invalid", "why": "a Cyrillic A (U+0410) in the code"},
    {"id": "p63", "section": "5.2", "input": "relay-operator.example/ＡＢＣＤ-EFGH-IJKL-MNOP", "expected": "invalid", "why": "fullwidth letters in the code"},
    {"id": "p64", "section": "5.2", "input": "relay-operator.example/", "expected": "invalid", "why": "no code"},
    {"id": "p65", "section": "5.2", "input": "relay-operator.example/ABCD_EFGH_IJKL_MNOP", "expected": "invalid", "why": "underscores in the code"},
    {"id": "p66", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNÖP", "expected": "invalid", "why": "a letter beyond ASCII in the code"},
    {"id": "p67", "section": "5.2", "input": "relay-operator.example/ABCD‐EFGH-IJKL-MNOP", "expected": "invalid", "why": "a Unicode hyphen (U+2010) instead of the hyphen"},
    {"id": "p68", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNOP\u0000", "expected": "invalid", "why": "a NUL at the end"},
    {"id": "p69", "section": "5.2", "input": "relay-operator.example/ABCD-EFGH-IJKL-MNOP/", "expected": "invalid", "why": "a slash at the end"}
  ]
}
