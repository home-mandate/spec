    {"id": "e12", "frames": [{"from": "gateway", "hex": "0001000701010367777f00"}], "expected": "error", "at": 0, "why": "gateway software with byte 0x7F"},
    {"id": "e13", "frames": [{"from": "gateway", "hex": "0001000701010367771f00"}], "expected": "error", "at": 0, "why": "gateway software with byte 0x1F"},
    {"id": "e14", "frames": [{"from": "gateway", "hex": "0001000e01010a676174657761792dc3a400"}], "expected": "error", "at": 0, "why": "gateway software in UTF-8 beyond ASCII"},
    {"id": "e15", "frames": [{"from": "gateway", "hex": "000100390101136578616d706c652d676174657761792f312e3011000100020003000400050006000700080009000a000b000c000d000e000f00100011"}], "expected": "error", "at": 0, "why": "17 capabilities"},
    {"id": "e16", "frames": [{"from": "gateway", "hex": "000100190101136578616d706c652d676174657761792f312e30010000"}], "expected": "error", "at": 0, "why": "capability 0"},
    {"id": "e17", "frames": [{"from": "gateway", "hex": "0001001b0101136578616d706c652d676174657761792f312e300200020001"}], "expected": "error", "at": 0, "why": "capabilities not ascending"},
    {"id": "e18", "frames": [{"from": "gateway", "hex": "0001001b0101136578616d706c652d676174657761792f312e300200010001"}], "expected": "error", "at": 0, "why": "capability twice"},
    {"id": "e19", "frames": [{"from": "relay", "hex": "000100170101136578616d706c652d676174657761792f312e3000"}], "expected": "error", "at": 0, "why": "hello from the relay"},
    {"id": "e20", "frames": [{"from": "gateway", "hex": "000100170101136578616d706c652d676174657761792f312e3000"}, {"from": "gateway", "hex": "000100170101136578616d706c652d676174657761792f312e3000"}], "expected": "error", "at": 1, "why": "second hello"},
    {"id": "e21", "frames": [{"from": "relay", "hex": "0002001901116578616d706c652d72656c61792f312e30001e01004000"}], "expected": "error", "at": 0, "why": "hello-ack before hello"},
    {"id": "e22", "frames": [{"from": "gateway", "hex": "000100170101136578616d706c652d676174657761792f312e3000"}, {"from": "gateway", "hex": "0002001901116578616d706c652d72656c61792f312e30001e01004000"}], "expected": "error", "at": 1, "why": "hello-ack from the gateway"},
    {"id": "e23", "frames": [{"from": "gateway", "hex": "000100170101136578616d706c652d676174657761792f312e3000"}, {"from": "relay", "hex": "0002001902116578616d706c652d72656c61792f312e30001e01004000"}], "expected": "error", "at": 1, "why": "hello-ack selects a version outside the range of hello"},
    {"id": "e24", "frames": [{"from": "gateway", "hex": "000100190101136578616d706c652d676174657761792f312e30010100"}, {"from": "relay", "hex": "0002001b01116578616d706c652d72656c61792f312e30001e010040010200"}], "expected": "error", "at": 1, "why": "hello-ack with a capability that hello did not offer"},
    {"id": "e25", "frames": [{"from": "gateway", "hex": "000100170101136578616d706c652d676174657761792f312e3000"}, {"from": "relay", "hex": "0002001901116578616d706c652d72656c61792f312e30000401004000"}], "expected": "error", "at": 1, "why": "heartbeat interval 4"},
    {"id": "e26", "frames": [{"from": "gateway", "hex": "000100170101136578616d706c652d676174657761792f312e3000"}, {"from": "relay", "hex": "0002001901116578616d706c652d72656c61792f312e30007901004000"}], "expected": "error", "at": 1, "why": "heartbeat interval 121"},
