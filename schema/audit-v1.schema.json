{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/audit/v1/audit.schema.json",
  "title": "Audit log entry v1",
  "description": "An entry in an implementation's audit log, version 1: version 0 and the events of remote access, Certificate Transparency monitoring, token binding, withdrawn credentials and relays. Entries are hash-chained via prev. See SPEC-v0.md sections 9 and 14.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "seq", "recorded_at", "event", "principal", "prev"],
  "properties": {
    "type": { "const": "https://home-mandate.org/audit/v1" },
    "id": {
      "description": "UUIDv7 (RFC 9562), lower case.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "seq": { "type": "integer", "minimum": 1 },
    "recorded_at": { "$ref": "#/$defs/date_time" },
    "event": {
      "enum": [
        "decision",
        "mandate.created", "mandate.updated", "mandate.revoked", "mandate.removed",
        "mandate.proposed", "mandate.discarded", "mandate.rejected",
        "agent.registered", "agent.revoked", "agent.reconnected", "agent.removed",
        "emergency_stop.activated", "emergency_stop.released",
        "auth.rejected",
        "log.truncated", "log.checkpoint", "log.exported",
        "directory.changed",
        "template.changed", "approver.changed",
        "issuer.changed", "config.changed",
        "agent.bound", "credentials.withdrawn",
        "cert.unexpected", "cert.acknowledged", "ct.status",
        "relay.paired", "relay.unpaired", "relay.status_changed", "relay.pins_changed",
        "relay.protection_changed", "relay.caa_alarm", "relay.acme_account_changed"
      ]
    },
    "principal": { "type": "string", "pattern": "^(household|person):[A-Za-z0-9_-]{1,64}$" },
    "actor": {
      "description": "Who triggered a change.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["user", "agent", "system"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id"],
      "properties": {
        "client_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "binding": { "description": "Only with agent.registered and agent.reconnected: whether the agent's tokens are bound to a key (SPEC-v0 section 11.7 item 6).", "enum": ["none", "dpop"] }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "resource", "action"],
      "properties": {
        "time": { "$ref": "#/$defs/date_time" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "revoked": { "description": "Revocation status at evaluation time; absent = false.", "type": "boolean" },
        "group": { "description": "The same in every decision entry of one request for several resources (SPEC-v0 sections 4.4 and 9.1): a UUID (RFC 9562), lower case.", "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "resource": {
          "description": "Resource as requested or resolved; unknown categories and identifiers that the evaluation found invalid are also logged unchanged, so identifiers here are limited only in length and number (SPEC-v0 section 9.1).",
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_id"],
          "properties": {
            "entity_id": { "description": "As the agent sent it, any character that I-JSON permits (SPEC-v0 sections 3.1 and 9.1): untrusted text wherever it is shown.", "type": "string", "minLength": 1, "maxLength": 255 },
            "category": { "description": "As the PEP gave it to the evaluation, any character that I-JSON permits (SPEC-v0 sections 3.1 and 9.1): untrusted text wherever it is shown.", "type": "string", "minLength": 1, "maxLength": 128 },
            "areas": { "description": "Set of areas of the resource as the PEP gave it to the evaluation, also when invalid (SPEC-v0 sections 3.4 and 9.1), any character: untrusted text wherever it is shown; absent or empty: the resource has no area.", "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "critical": { "description": "true: the directory marked the resource as critical at evaluation time; absent = false.", "type": "boolean" }
          }
        },
        "action": { "description": "As the agent sent it, any character that I-JSON permits (SPEC-v0 sections 3.1 and 9.1): untrusted text wherever it is shown.", "type": "string", "minLength": 1, "maxLength": 64 },
        "parameters": {
          "description": "Parameters of the action that were input to the evaluation (SPEC-v0 section 4.5): integers or strings.",
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "additionalProperties": {
            "anyOf": [
              { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              { "type": "string", "pattern": "^[!-~]{1,64}$" }
            ]
          }
        }
      }
    },
    "mandate": {
      "description": "id and digest are required except with mandate.rejected, where digest is present if the document was a JSON object and id if it named one (SPEC-v0 section 9.1).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
        "digest": { "$ref": "#/$defs/digest" },
        "previous_digest": { "description": "Required with mandate.updated (the version replaced); with mandate.proposed the version held when the proposal was recorded, if any; mandate.discarded repeats the proposal's value; absent with every other event. Differs from digest (SPEC-v0 section 9.1).", "$ref": "#/$defs/digest" },
        "cause": {
          "description": "Only with mandate.discarded (rejected, superseded, revoked, expired: why a proposal did not take effect) and mandate.rejected (invalid, signature, untrusted_issuer, succession, unsupported: why a mandate from outside was not accepted), required there (SPEC-v0 section 9.1).",
          "enum": ["rejected", "superseded", "revoked", "expired", "invalid", "signature", "untrusted_issuer", "succession", "unsupported"]
        }
      }
    },
    "vocabulary": {
      "description": "The vocabulary the evaluation used for the category of the resource (SPEC-v0 sections 5 and 9.1): id and version as in its file. Only with decision and evaluation, and not with reason unknown_resource or unknown_category. For a category of Section 5 the id is https://home-mandate.org/vocabulary/v0, for an extension category the id of the extension; the schema cannot see the vocabulary, a verifier checks it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[a-z][a-z0-9+.-]{0,31}:[!-~]{1,480}$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "rule_id"],
      "properties": {
        "decision": { "enum": ["allow", "ask", "deny"] },
        "reason": { "$ref": "#/$defs/reason" },
        "rule_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "approval_timeout": { "type": "string", "minLength": 4, "pattern": "^PT([0-9]{1,5}H)?([0-9]{1,5}M)?([0-9]{1,5}S)?$" },
        "enforced": {
          "description": "Only false: a deny by the rules of a mandate in audit mode that the PEP did not enforce (SPEC-v0 section 4.6). Absent: the decision was enforced.",
          "const": false
        },
        "confirm": {
          "description": "Only true: the deny that was not enforced required a confirmation, because a matching rule decides ask (SPEC-v0 section 4.6). Only with enforced. Absent: no confirmation was required beyond what the decision says.",
          "const": true
        }
      },
      "allOf": [
        { "if": { "required": ["enforced"] },
          "then": { "properties": { "decision": { "const": "deny" }, "reason": { "enum": ["no_match", "rule"] } } } },
        { "if": { "required": ["confirm"] },
          "then": { "required": ["enforced", "approval_timeout"], "properties": { "reason": { "const": "rule" } } } },
        { "if": { "properties": { "decision": { "const": "allow" } } },
          "then": { "properties": { "reason": { "const": "rule" } } } },
        { "if": { "properties": { "decision": { "const": "ask" } } },
          "then": { "required": ["approval_timeout"], "properties": { "reason": { "enum": ["rule", "critical_demotion"] } } } },
        { "if": { "required": ["approval_timeout"] },
          "then": { "anyOf": [ { "properties": { "decision": { "const": "ask" } } }, { "required": ["confirm"] } ] } },
        { "if": { "properties": { "decision": { "const": "deny" } } },
          "then": { "properties": { "reason": { "not": { "const": "critical_demotion" } } } } }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "at"],
      "properties": {
        "outcome": { "enum": ["approved", "rejected", "timeout", "invalid_response", "cancelled"] },
        "cause": {
          "description": "Why a request ended without an answer before its timeout (SPEC-v0 section 11.1). Only with outcome cancelled, and required there.",
          "enum": ["withdrawn", "revoked", "emergency_stop", "interrupted"]
        },
        "by": { "type": "string", "minLength": 1, "maxLength": 128 },
        "via": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "description": "Channel through which the answer arrived, an implementation-defined code such as push or ui. Only together with by."
        },
        "at": { "$ref": "#/$defs/date_time" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["executed", "denied", "failed"] },
        "denied_by": { "description": "Who or what denied: audit is a request the PEP did not execute because it could not record it (SPEC-v0 section 9).", "enum": ["mandate", "approval", "rate_limit", "emergency_stop", "authentication", "audit"] },
        "error": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "count": {
          "description": "Number of consecutive requests of the agent that this entry stands for. Only with denied_by rate_limit (SPEC-v0 section 11.2).",
          "type": "integer",
          "minimum": 2
        }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "denied" } } },
          "then": { "required": ["denied_by"] }, "else": { "not": { "required": ["denied_by"] } } },
        { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "required": ["error"] } },
        { "if": { "properties": { "status": { "const": "executed" } } }, "then": { "not": { "required": ["error"] } } },
        { "if": { "required": ["count"] }, "then": { "properties": { "denied_by": { "const": "rate_limit" } } } }
      ]
    },
    "exported": {
      "description": "Range of entries an export contained (SPEC-v0 sections 9.1 and 13): from_seq <= to_seq < the entry's own seq. Only with log.exported.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from_seq", "to_seq"],
      "properties": {
        "from_seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "to_seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "truncated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["up_to_seq", "last_digest"],
      "properties": {
        "up_to_seq": { "type": "integer", "minimum": 1 },
        "last_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "checkpoint": {
      "description": "Signed statement about the log up to and including the previous entry (SPEC-v0 section 9.5).",
      "type": "object",
      "additionalProperties": false,
      "required": ["log_id", "signature"],
      "properties": {
        "log_id": {
          "description": "Identifier of the audit log, a UUID in lower case; the same in every checkpoint of the log.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "signature": {
          "description": "Compact JWS with detached payload (RFC 7515 appendix F), algorithm EdDSA or ES256.",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+[.][.][A-Za-z0-9_-]+$"
        }
      }
    },
    "directory": {
      "description": "Change to the resource directory that affects the evaluation (SPEC-v0 section 11.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "entity_id"],
      "properties": {
        "change": { "enum": ["added", "removed", "critical_marked", "critical_unmarked", "category_changed", "areas_changed", "renamed", "rename_applied", "rename_dismissed"] },
        "entity_id": { "$ref": "#/$defs/entity_id" },
        "previous_entity_id": { "$ref": "#/$defs/entity_id" },
        "category": { "description": "With added and removed optionally, with category_changed required: the category of the resource (SPEC-v0 section 9.1).", "$ref": "#/$defs/category" },
        "previous_category": { "description": "Only with category_changed; differs from category.", "$ref": "#/$defs/category" },
        "areas": { "description": "With added and removed optionally, with areas_changed required: the set of areas of the resource, empty for none (SPEC-v0 sections 3.4 and 9.1).", "$ref": "#/$defs/areas" },
        "previous_areas": { "description": "Only with areas_changed; another set than areas.", "$ref": "#/$defs/areas" }
      },
      "allOf": [
        { "if": { "properties": { "change": { "enum": ["renamed", "rename_applied", "rename_dismissed"] } } },
          "then": { "required": ["previous_entity_id"] }, "else": { "not": { "required": ["previous_entity_id"] } } },
        { "if": { "properties": { "change": { "const": "category_changed" } } },
          "then": { "required": ["category", "previous_category"] }, "else": { "not": { "required": ["previous_category"] } } },
        { "if": { "properties": { "change": { "const": "areas_changed" } } },
          "then": { "required": ["areas", "previous_areas"] }, "else": { "not": { "required": ["previous_areas"] } } },
        { "if": { "properties": { "change": { "enum": ["added", "removed", "category_changed"] } } },
          "else": { "not": { "required": ["category"] } } },
        { "if": { "properties": { "change": { "enum": ["added", "removed", "areas_changed"] } } },
          "else": { "not": { "required": ["areas"] } } }
      ]
    },
    "template": {
      "description": "Change to a mandate template, a stored mandate draft from which the implementation creates mandates (SPEC-v0 section 9.1). Never its content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "name"],
      "properties": {
        "change": { "enum": ["stored", "removed", "hidden", "shown"] },
        "name": { "description": "Name of the template; displayed text.", "type": "string", "minLength": 1, "maxLength": 64 },
        "digest": { "description": "stored: the new content; removed: the last content; hidden, shown: optionally the current content.", "$ref": "#/$defs/digest" },
        "previous_digest": { "description": "Only with stored, if the template had content before; differs from digest.", "$ref": "#/$defs/digest" }
      },
      "allOf": [
        { "if": { "properties": { "change": { "enum": ["stored", "removed"] } } },
          "then": { "required": ["digest"] } },
        { "if": { "properties": { "change": { "const": "stored" } } },
          "else": { "not": { "required": ["previous_digest"] } } }
      ]
    },
    "issuer": {
      "description": "Change to the issuers a verifier trusts and to their keys (SPEC-v0 section 7.1). kid only with key_added and key_removed, required there.",
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "issuer"],
      "properties": {
        "change": { "enum": ["trusted", "untrusted", "key_added", "key_removed"] },
        "issuer": { "description": "The issuer as a mandate names it (SPEC-v0 section 3.5).", "type": "string", "minLength": 1, "maxLength": 512 },
        "kid": { "description": "The key ID of the key added or removed (SPEC-v0 section 7.1).", "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
      },
      "if": { "properties": { "change": { "enum": ["key_added", "key_removed"] } } },
      "then": { "required": ["kid"] },
      "else": { "not": { "required": ["kid"] } }
    },
    "config": {
      "description": "Change to a setting that affects every evaluation, the anchoring of the log or remote access (SPEC-v0 sections 9.5, 11.4 and 11.7): the household time zone, the clock check, the checkpoint key, the public origin, remote access on or off, and whether tokens that are not bound are refused. previous_value, if present, differs from value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "value"],
      "properties": {
        "setting": { "enum": ["timezone", "clock_check", "checkpoint_key", "public_origin", "remote_access", "unbound_tokens"] },
        "value": { "type": "string" },
        "previous_value": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "setting": { "const": "clock_check" } } },
          "then": { "properties": { "value": { "enum": ["on", "off"] }, "previous_value": { "enum": ["on", "off"] } } } },
        { "if": { "properties": { "setting": { "const": "checkpoint_key" } } },
          "then": { "properties": { "value": { "pattern": "^[A-Za-z0-9._-]{1,64}$" }, "previous_value": { "pattern": "^[A-Za-z0-9._-]{1,64}$" } } } },
        { "if": { "properties": { "setting": { "enum": ["timezone", "clock_check", "checkpoint_key"] } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/setting_value" }, "previous_value": { "$ref": "#/$defs/setting_value" } } } },
        { "if": { "properties": { "setting": { "const": "public_origin" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/public_origin" }, "previous_value": { "$ref": "#/$defs/public_origin" } } } },
        { "if": { "properties": { "setting": { "const": "remote_access" } } },
          "then": { "properties": { "value": { "enum": ["on", "off"] }, "previous_value": { "enum": ["on", "off"] } } } },
        { "if": { "properties": { "setting": { "const": "unbound_tokens" } } },
          "then": { "properties": { "value": { "enum": ["allowed", "refused"] }, "previous_value": { "enum": ["allowed", "refused"] } } } }
      ]
    },
    "approver": {
      "description": "Change to the humans the implementation lets answer approval requests (SPEC-v0 section 11.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "id"],
      "properties": {
        "change": { "enum": ["added", "removed"] },
        "id": { "description": "Identifier of the approver in the user management, as in approval.by; displayed text.", "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "binding": {
      "description": "Only with agent.bound: the key the agent's tokens are bound to from now on (SPEC-v0 section 11.7 item 6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "jkt"],
      "properties": {
        "method": { "const": "dpop" },
        "jkt": { "description": "JWK SHA-256 thumbprint of the key (RFC 7638), base64url without padding.", "$ref": "#/$defs/sha256_b64url" }
      }
    },
    "credentials": {
      "description": "Only with credentials.withdrawn: whose access and refresh tokens lost their validity, and why (SPEC-v0 sections 11.3 and 11.7 item 2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "cause"],
      "properties": {
        "scope": { "description": "all: of every agent; agent: of the agent the entry names.", "enum": ["all", "agent"] },
        "cause": { "description": "emergency_stop: together with an emergency stop; public_origin: the public origin changed; user: a human withdrew them.", "enum": ["emergency_stop", "public_origin", "user"] }
      }
    },
    "certificate": {
      "description": "Only with cert.unexpected and cert.acknowledged: a certificate for the host of the public origin (SPEC-v0 section 11.7 item 7). names and issuer are taken from the certificate, which anyone may have obtained: they are recorded unchanged and shown as untrusted text (SPEC-v0 section 9.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "digest": { "description": "SHA-256 of the DER of the TBSCertificate without the poison and the SCT list, base64url without padding.", "$ref": "#/$defs/sha256_b64url" },
        "status": { "description": "alarm: valid since monitoring began or later; not_yet_valid: its notBefore lies after the check; past_exposure: it expired before the check.", "enum": ["alarm", "not_yet_valid", "past_exposure"] },
        "names": { "description": "The names of the certificate that match the host, at most 16.", "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 253 } },
        "issuer": { "description": "The issuer of the certificate as its distinguished name.", "type": "string", "minLength": 1, "maxLength": 1024 },
        "public_key": { "description": "SHA-256 of the SubjectPublicKeyInfo, base64url without padding.", "$ref": "#/$defs/sha256_b64url" },
        "not_before": { "$ref": "#/$defs/date_time" },
        "not_after": { "$ref": "#/$defs/date_time" },
        "logged": { "description": "The time of its first log entry.", "$ref": "#/$defs/date_time" }
      }
    },
    "ct": {
      "description": "Only with ct.status: the state of Certificate Transparency monitoring (SPEC-v0 section 11.7 item 7). ok: at least two independent sources answered within 24 hours; limited: only one; unavailable: none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ok", "limited", "unavailable"] },
        "previous_status": { "enum": ["ok", "limited", "unavailable"] }
      }
    },
    "relay": {
      "description": "Only with the relay.* events: what a gateway paired with a relay records (Home-Mandate Relay Specification, RELAY-v0). Values the operator sent are recorded unchanged and shown as untrusted text (SPEC-v0 section 9.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["operator"],
      "properties": {
        "operator": { "description": "The operator domain, as A-labels.", "$ref": "#/$defs/domain" },
        "home_id": { "description": "The home ID the operator assigned (RELAY-v0 section 2).", "type": "string", "pattern": "^[a-z2-7]{26}$" },
        "name": { "description": "relay.paired: the standard name; relay.protection_changed and relay.caa_alarm: the name concerned; for relay.caa_alarm at the apex, the apex of the name domain.", "$ref": "#/$defs/domain" },
        "cause": { "description": "Only with relay.unpaired. local: the local administrator ended the pairing; operator: the operator or the household's portal did; replaced: another gateway took the installation over.", "enum": ["local", "operator", "replaced"] },
        "status": { "description": "Only with relay.status_changed: the status of the installation the operator reports.", "enum": ["active", "paused", "blocked"] },
        "previous_status": { "enum": ["active", "paused", "blocked"] },
        "source": { "description": "Only with relay.pins_changed. relay: announced over a tunnel authenticated with a stored pin; admin: taken by the local administrator after a warning (RELAY-v0 section 6.8).", "enum": ["relay", "admin"] },
        "active_pins": { "type": "integer", "minimum": 1, "maximum": 8 },
        "backup_pins": { "type": "integer", "minimum": 0, "maximum": 7 },
        "level": { "description": "Only with relay.protection_changed (RELAY-v0 section 6.5).", "enum": ["standard", "own_domain"] },
        "previous_level": { "enum": ["standard", "own_domain"] },
        "scope": { "description": "Only with relay.caa_alarm: the standard name or the apex of the name domain (RELAY-v0 section 6.7).", "enum": ["name", "apex"] },
        "account": { "description": "Only with relay.acme_account_changed: the ACME account URI the gateway reported (RELAY-v0 section 5.6).", "type": "string", "pattern": "^https://[!-~]{1,500}$" },
        "change": { "description": "Only with relay.acme_account_changed. reported: the gateway reported the account; confirmed: the household confirmed a change of account.", "enum": ["reported", "confirmed"] }
      }
    },
    "prev": {
      "description": "Digest of the previous entry; null only for the first entry of an audit log (seq 1).",
      "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/digest" } ]
    }
  },
  "allOf": [
    { "if": { "properties": { "event": { "const": "decision" } } },
      "then": { "required": ["agent", "request", "result"] } },
    { "if": { "required": ["vocabulary"] },
      "then": { "required": ["evaluation"],
                "properties": { "event": { "const": "decision" },
                                "evaluation": { "properties": { "reason": { "not": { "enum": ["unknown_resource", "unknown_category"] } } } } } } },
    { "if": { "properties": { "event": { "enum": ["mandate.created", "mandate.updated", "mandate.revoked", "mandate.removed", "mandate.proposed", "mandate.discarded"] } } },
      "then": { "required": ["actor", "mandate"] } },
    { "if": { "properties": { "event": { "const": "mandate.rejected" } } },
      "then": { "required": ["actor", "mandate"], "properties": { "mandate": { "required": ["cause"], "properties": { "cause": { "enum": ["invalid", "signature", "untrusted_issuer", "succession", "unsupported"] } } } } },
      "else": { "properties": { "mandate": { "required": ["id", "digest"] } } } },
    { "if": { "properties": { "event": { "const": "mandate.discarded" } } },
      "then": { "properties": { "mandate": { "required": ["cause"], "properties": { "cause": { "enum": ["rejected", "superseded", "revoked", "expired"] } } } } } },
    { "if": { "properties": { "event": { "enum": ["mandate.discarded", "mandate.rejected"] } } },
      "else": { "properties": { "mandate": { "not": { "required": ["cause"] } } } } },
    { "if": { "properties": { "event": { "const": "log.exported" } } },
      "then": { "required": ["actor"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } },
      "else": { "not": { "required": ["exported"] } } },
    { "if": { "properties": { "event": { "const": "mandate.updated" } } },
      "then": { "properties": { "mandate": { "required": ["previous_digest"] } } } },
    { "if": { "properties": { "event": { "enum": ["mandate.updated", "mandate.proposed", "mandate.discarded"] } } },
      "else": { "properties": { "mandate": { "not": { "required": ["previous_digest"] } } } } },
    { "if": { "properties": { "event": { "enum": ["mandate.created", "mandate.updated", "mandate.proposed", "mandate.discarded", "mandate.rejected"] } } },
      "then": { "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } } },
    { "if": { "properties": { "event": { "enum": ["agent.registered", "agent.revoked", "agent.reconnected", "agent.removed"] } } },
      "then": { "required": ["actor", "agent"] } },
    { "if": { "properties": { "event": { "enum": ["mandate.removed", "agent.removed"] } } },
      "then": { "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } } },
    { "if": { "properties": { "event": { "const": "agent.reconnected" } } },
      "then": { "properties": { "actor": { "properties": { "kind": { "const": "user" } } } } } },
    { "if": { "properties": { "event": { "enum": ["emergency_stop.activated", "emergency_stop.released"] } } },
      "then": { "required": ["actor"] } },
    { "if": { "properties": { "event": { "const": "emergency_stop.released" } } },
      "then": { "properties": { "actor": { "properties": { "kind": { "const": "user" } } } } } },
    { "if": { "properties": { "event": { "const": "auth.rejected" } } },
      "then": { "required": ["result"] } },
    { "if": { "properties": { "event": { "const": "log.truncated" } } },
      "then": { "required": ["actor", "truncated"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } } },
    { "if": { "properties": { "event": { "const": "directory.changed" } } },
      "then": { "required": ["actor", "directory"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } },
      "else": { "not": { "required": ["directory"] } } },
    { "if": { "properties": { "event": { "const": "template.changed" } } },
      "then": { "required": ["actor", "template"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } },
      "else": { "not": { "required": ["template"] } } },
    { "if": { "properties": { "event": { "const": "issuer.changed" } } },
      "then": { "required": ["actor", "issuer"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } },
      "else": { "not": { "required": ["issuer"] } } },
    { "if": { "properties": { "event": { "const": "config.changed" } } },
      "then": { "required": ["actor", "config"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } },
      "else": { "not": { "required": ["config"] } } },
    { "if": { "properties": { "event": { "const": "approver.changed" } } },
      "then": { "required": ["actor", "approver"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } },
      "else": { "not": { "required": ["approver"] } } },
    { "if": { "properties": { "event": { "enum": ["agent.registered", "agent.reconnected"] } } },
      "else": { "properties": { "agent": { "not": { "required": ["binding"] } } } } },
    { "if": { "properties": { "event": { "const": "agent.bound" } } },
      "then": { "required": ["actor", "agent", "binding"], "properties": { "actor": { "properties": { "kind": { "enum": ["agent", "system"] } } } } },
      "else": { "not": { "required": ["binding"] } } },
    { "if": { "properties": { "event": { "const": "credentials.withdrawn" } } },
      "then": { "required": ["actor", "credentials"], "properties": { "actor": { "properties": { "kind": { "enum": ["user", "system"] } } } } },
      "else": { "not": { "required": ["credentials"] } } },
    { "if": { "required": ["credentials"], "properties": { "credentials": { "properties": { "scope": { "const": "agent" } } } } },
      "then": { "required": ["agent"] } },
    { "if": { "required": ["credentials"], "properties": { "credentials": { "properties": { "scope": { "const": "all" } } } } },
      "then": { "not": { "required": ["agent"] } } },
    { "if": { "required": ["credentials"], "properties": { "credentials": { "properties": { "cause": { "enum": ["emergency_stop", "public_origin"] } } } } },
      "then": { "properties": { "credentials": { "properties": { "scope": { "const": "all" } } } } } },
    { "if": { "required": ["credentials"], "properties": { "credentials": { "properties": { "cause": { "const": "user" } } } } },
      "then": { "properties": { "actor": { "properties": { "kind": { "const": "user" } } } } } },
    { "if": { "properties": { "event": { "const": "cert.unexpected" } } },
      "then": { "required": ["certificate"], "properties": { "certificate": { "required": ["status", "names", "issuer", "public_key", "not_before", "not_after", "logged"] } } } },
    { "if": { "properties": { "event": { "const": "cert.acknowledged" } } },
      "then": { "required": ["actor", "certificate"], "properties": { "actor": { "properties": { "kind": { "const": "user" } } }, "certificate": { "maxProperties": 1 } } } },
    { "if": { "properties": { "event": { "enum": ["cert.unexpected", "cert.acknowledged"] } } },
      "else": { "not": { "required": ["certificate"] } } },
    { "if": { "properties": { "event": { "const": "ct.status" } } },
      "then": { "required": ["ct"] },
      "else": { "not": { "required": ["ct"] } } },
    { "if": { "properties": { "event": { "enum": ["relay.paired", "relay.unpaired", "relay.status_changed", "relay.pins_changed", "relay.protection_changed", "relay.caa_alarm", "relay.acme_account_changed"] } } },
      "then": { "required": ["relay"] },
      "else": { "not": { "required": ["relay"] } } },
    { "if": { "properties": { "event": { "const": "relay.paired" } } },
      "then": { "required": ["actor"], "properties": { "actor": { "properties": { "kind": { "const": "user" } } }, "relay": { "required": ["home_id", "name"], "propertyNames": { "enum": ["operator", "home_id", "name"] } } } } },
    { "if": { "properties": { "event": { "const": "relay.unpaired" } } },
      "then": { "properties": { "relay": { "required": ["home_id", "cause"], "propertyNames": { "enum": ["operator", "home_id", "cause"] } } } } },
    { "if": { "properties": { "event": { "const": "relay.status_changed" } } },
      "then": { "properties": { "relay": { "required": ["home_id", "status"], "propertyNames": { "enum": ["operator", "home_id", "status", "previous_status"] } } } } },
    { "if": { "properties": { "event": { "const": "relay.pins_changed" } } },
      "then": { "properties": { "relay": { "required": ["source", "active_pins", "backup_pins"], "propertyNames": { "enum": ["operator", "source", "active_pins", "backup_pins"] } } } } },
    { "if": { "properties": { "event": { "const": "relay.protection_changed" } } },
      "then": { "properties": { "relay": { "required": ["name", "level"], "propertyNames": { "enum": ["operator", "name", "level", "previous_level"] } } } } },
    { "if": { "properties": { "event": { "const": "relay.caa_alarm" } } },
      "then": { "properties": { "relay": { "required": ["name", "scope"], "propertyNames": { "enum": ["operator", "name", "scope"] } } } } },
    { "if": { "properties": { "event": { "const": "relay.acme_account_changed" } } },
      "then": { "properties": { "relay": { "required": ["account", "change"], "propertyNames": { "enum": ["operator", "account", "change"] } } } } },
    { "if": { "properties": { "event": { "const": "log.checkpoint" } } },
      "then": { "required": ["checkpoint"], "properties": { "seq": { "minimum": 2 } } },
      "else": { "not": { "required": ["checkpoint"] } } },
    { "if": { "required": ["approval"] },
      "then": { "required": ["evaluation"], "properties": { "evaluation": { "anyOf": [ { "properties": { "decision": { "const": "ask" } } }, { "required": ["confirm"] } ] } } } },
    { "if": { "required": ["approval"], "properties": { "approval": { "properties": { "outcome": { "enum": ["approved", "rejected", "invalid_response"] } } } } },
      "then": { "properties": { "approval": { "required": ["by"] } } } },
    { "if": { "required": ["approval"], "properties": { "approval": { "required": ["via"] } } },
      "then": { "properties": { "approval": { "required": ["by"] } } } },
    { "if": { "required": ["approval"], "properties": { "approval": { "required": ["outcome"], "properties": { "outcome": { "const": "cancelled" } } } } },
      "then": { "required": ["result"],
                "properties": { "approval": { "required": ["cause"], "not": { "required": ["by"] } },
                                "result": { "required": ["status", "denied_by"], "properties": { "status": { "const": "denied" } } } } },
      "else": { "properties": { "approval": { "not": { "required": ["cause"] } } } } },
    { "if": { "required": ["approval"], "properties": { "approval": { "required": ["cause"], "properties": { "cause": { "enum": ["withdrawn", "interrupted"] } } } } },
      "then": { "properties": { "result": { "properties": { "denied_by": { "const": "approval" } } } } } },
    { "if": { "required": ["approval"], "properties": { "approval": { "required": ["cause"], "properties": { "cause": { "const": "revoked" } } } } },
      "then": { "properties": { "result": { "properties": { "denied_by": { "enum": ["authentication", "mandate"] } } } } } },
    { "if": { "required": ["approval"], "properties": { "approval": { "required": ["cause"], "properties": { "cause": { "const": "emergency_stop" } } } } },
      "then": { "properties": { "result": { "properties": { "denied_by": { "const": "emergency_stop" } } } } } },
    { "if": { "required": ["result"], "properties": { "result": { "required": ["denied_by"], "properties": { "denied_by": { "const": "audit" } } } } },
      "then": { "properties": { "approval": { "properties": { "outcome": { "const": "approved" } } } } } },
    { "if": { "required": ["result"], "properties": { "result": { "required": ["status"], "properties": { "status": { "const": "executed" } } } } },
      "then": { "required": ["evaluation", "mandate"],
                "properties": { "evaluation": { "anyOf": [ { "properties": { "decision": { "enum": ["allow", "ask"] } } }, { "required": ["enforced"] } ] } } } },
    { "if": { "required": ["result", "evaluation"],
              "properties": { "result": { "required": ["status"], "properties": { "status": { "const": "executed" } } },
                              "evaluation": { "anyOf": [ { "required": ["decision"], "properties": { "decision": { "const": "ask" } } }, { "required": ["confirm"] } ] } } },
      "then": { "required": ["approval"], "properties": { "approval": { "properties": { "outcome": { "const": "approved" } } } } } },
    { "if": { "required": ["evaluation"], "properties": { "evaluation": { "required": ["decision"], "properties": { "decision": { "const": "deny" } }, "not": { "required": ["enforced"] } } } },
      "then": { "required": ["result"], "properties": { "result": { "required": ["status", "denied_by"], "properties": { "status": { "const": "denied" }, "denied_by": { "const": "mandate" } } } } } },
    { "if": { "required": ["evaluation"], "properties": { "evaluation": { "required": ["enforced"] } } },
      "then": { "required": ["event", "result", "mandate", "request"],
                "properties": { "event": { "const": "decision" },
                                "request": { "properties": { "resource": { "required": ["category", "critical"] } } } },
                "not": { "properties": { "request": { "required": ["resource", "action"],
                                                      "properties": { "resource": { "required": ["critical"], "properties": { "critical": { "const": true } } },
                                                                      "action": { "not": { "const": "read" } } } } } } } },
    { "if": { "required": ["evaluation", "result"],
              "properties": { "evaluation": { "required": ["confirm"] }, "result": { "required": ["denied_by"], "properties": { "denied_by": { "const": "mandate" } } } } },
      "then": { "required": ["approval"],
                "properties": { "approval": { "anyOf": [ { "properties": { "outcome": { "const": "approved" } } },
                                                         { "required": ["cause"], "properties": { "cause": { "const": "revoked" } } } ] } } } },
    { "if": { "required": ["evaluation"], "properties": { "evaluation": { "required": ["enforced"], "not": { "required": ["confirm"] } } } },
      "then": { "properties": { "result": { "required": ["status"], "anyOf": [ { "properties": { "status": { "enum": ["executed", "failed"] } } },
                                                                                { "properties": { "status": { "const": "denied" }, "denied_by": { "const": "audit" } } } ] } } } },
    { "if": { "properties": { "seq": { "const": 1 } } },
      "then": { "properties": { "prev": { "type": "null" } } },
      "else": { "properties": { "prev": { "$ref": "#/$defs/digest" } } } }
  ],
  "$defs": {
    "sha256_b64url": {
      "description": "A SHA-256 digest in base64url without padding.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "domain": {
      "description": "A DNS name of at least two labels in lower case, as A-labels, without a final dot.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[.])+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "public_origin": {
      "description": "A public origin in its one form (SPEC-v0 section 11.7 item 1); a verifier also checks the rules of that item that a pattern cannot express.",
      "type": "string",
      "maxLength": 270,
      "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[.])+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(:[1-9][0-9]{0,4})?$"
    },
    "setting_value": {
      "description": "The value of a setting: an IANA time zone name, on or off for the clock check, a key ID for the checkpoint key; printable ASCII without space.",
      "type": "string",
      "pattern": "^[!-~]{1,64}$"
    },
    "date_time": {
      "description": "Timestamp according to RFC 3339 with offset; asserting format is required (SPEC-v0 section 3.1 item 0).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "not": { "anyOf": [ { "pattern": "^0000[!-~]*$" }, { "pattern": "^[!-~]*-00:00$" } ] }
    },
    "entity_id": {
      "description": "Identifier of a resource in the directory: printable ASCII without space, compared exactly per character (SPEC-v0 section 3.4).",
      "type": "string",
      "pattern": "^[!-~]{1,255}$"
    },
    "category": {
      "description": "A category of SPEC-v0 section 5 or an extension category (section 5.1), as in a mandate.",
      "anyOf": [
        { "enum": ["light", "switch", "climate", "cover", "gate", "lock", "alarm", "camera", "media", "sensor", "scene", "script", "other"] },
        { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[a-z][a-z0-9_]{0,31}$" }
      ]
    },
    "areas": {
      "description": "Set of areas of a resource in the directory (SPEC-v0 section 3.4); empty: no area.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[!-~]{1,64}$" }
    },
    "digest": {
      "description": "SHA-256 over the canonical form according to RFC 8785, hexadecimal, lower case.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason": {
      "description": "Reason code of the evaluation, SPEC-v0 section 4.1.",
      "enum": ["rule", "critical_demotion", "no_match", "revoked", "not_yet_valid", "expired",
               "no_mandate", "ambiguous_mandate", "invalid_mandate", "invalid_request", "unknown_resource", "unknown_category", "unknown_action"]
    }
  }
}
