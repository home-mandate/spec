{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/vocabulary/v0/vocabulary.schema.json",
  "title": "Vocabulary v0",
  "description": "A vocabulary: categories with their actions. Used for the core vocabulary of SPEC-v0 section 5 and for extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "categories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "id": {
      "description": "Identifier of the vocabulary, a URI.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]{0,31}:[!-~]{1,480}$"
    },
    "version": {
      "description": "Version of the vocabulary. A vocabulary never changes under the same id and version.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "description": "A core category (lower case) or a namespaced extension category, e.g. paperless:document.",
        "pattern": "^[a-z][a-z0-9_-]{0,31}(:[a-z][a-z0-9_]{0,31})?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actions"
        ],
        "properties": {
          "actions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "critical": {
                  "description": "true: the action is critical (SPEC-v0 section 4, step 5). Absent: not critical.",
                  "const": true
                },
                "parameters": {
                  "description": "Parameters of the action that a rule can constrain (SPEC-v0 section 4.5): integers in a unit, or strings.",
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "unit"
                        ],
                        "properties": {
                          "type": {
                            "const": "integer"
                          },
                          "unit": {
                            "description": "Unit of the integer value, chosen fine enough that no fraction is needed.",
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "minimum": {
                            "description": "Smallest valid value, inclusive. A request with a smaller value is invalid (SPEC-v0 section 4, step 0).",
                            "type": "integer"
                          },
                          "maximum": {
                            "description": "Largest valid value, inclusive. A request with a larger value is invalid (SPEC-v0 section 4, step 0).",
                            "type": "integer"
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "string"
                          },
                          "values": {
                            "description": "The permitted values, at most 32 like the values of a one_of. A request with another value is invalid, and so is a mandate whose constraint names another value (SPEC-v0 sections 3.1 and 4). Absent: any string of 1 to 64 printable ASCII characters without space.",
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^[!-~]{1,64}$"
                            }
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
