{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate-spec.org/conformance/v0/audit.schema.json",
  "title": "Audit logs v0 (SPEC-v0 sections 8 and 9.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "logs"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expected",
          "entries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "why": {
            "type": "string"
          },
          "expected": {
            "enum": [
              "valid",
              "invalid"
            ]
          },
          "broken_at": {
            "type": "integer",
            "minimum": 0,
            "description": "seq of the first violating entry; 0 if it has no readable seq."
          },
          "entry_digests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "entries": {
            "type": "array",
            "description": "Entries in file order. Deliberately unconstrained: invalid logs contain entries that violate the audit schema."
          }
        },
        "if": {
          "properties": {
            "expected": {
              "const": "invalid"
            }
          }
        },
        "then": {
          "required": [
            "broken_at"
          ]
        },
        "else": {
          "not": {
            "required": [
              "broken_at"
            ]
          }
        }
      }
    }
  }
}
