{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/conformance/v0/succession.schema.json",
  "title": "Succession cases v0 (SPEC-v0 sections 3.5 and 8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stored",
          "offered",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "stored": {
            "type": "object",
            "description": "The valid mandate an implementation has stored, or remembers after it was revoked or removed."
          },
          "stored_revoked": {
            "type": "boolean",
            "description": "true: the stored mandate is revoked; absent or false: active."
          },
          "offered": {
            "type": "object",
            "description": "The valid mandate offered as its replacement."
          },
          "expected": {
            "enum": [
              "accept",
              "reject"
            ]
          },
          "confirm": {
            "type": "boolean",
            "description": "true: the accepted successor takes effect only after a human confirmed it (SPEC-v0 section 3.5); absent or false: it takes effect at once. Only with accept."
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
