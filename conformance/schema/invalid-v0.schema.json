{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate-spec.org/conformance/v0/invalid.schema.json",
  "title": "Invalid mandates v0 (SPEC-v0 sections 3.1 and 8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "why"
        ],
        "oneOf": [
          {
            "required": [
              "mandate_inline"
            ]
          },
          {
            "required": [
              "mandate_raw"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "mandate_inline": {
            "type": "object",
            "description": "The mandate inline."
          },
          "mandate_raw": {
            "type": "string",
            "description": "The mandate as raw JSON text, for errors that cannot be expressed as a JSON object."
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
