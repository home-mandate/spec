{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/conformance/v0/invalid.schema.json",
  "title": "Invalid mandates v0 (SPEC-v0 sections 3.1 and 8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "why"
        ],
        "oneOf": [
          {
            "required": [
              "mandate_inline"
            ]
          },
          {
            "required": [
              "mandate_raw"
            ]
          },
          {
            "required": [
              "mandate_base64"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "mandate_inline": {
            "type": "object",
            "description": "The mandate inline."
          },
          "mandate_raw": {
            "type": "string",
            "description": "The mandate as raw JSON text, for errors that cannot be expressed as a JSON object."
          },
          "mandate_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "description": "The bytes of the mandate in base64 with padding (RFC 4648 section 4), for errors in the bytes such as bytes that are not UTF-8 (SPEC-v0 section 10.2)."
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
