{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate-spec.org/conformance/v0/signed.schema.json",
  "title": "Signed mandate cases v0 (SPEC-v0 sections 7 and 8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jws",
          "keys",
          "issuer",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "jws": {
            "type": "string",
            "description": "The signed mandate: a compact JWS."
          },
          "keys": {
            "type": "string",
            "description": "Path to the JWK Set the verifier trusts for the issuer, relative to the repository root."
          },
          "issuer": {
            "type": "string",
            "description": "The issuer the keys are trusted for."
          },
          "expected": {
            "enum": [
              "valid",
              "invalid"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Digest of the mandate; for valid cases."
          },
          "why": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "expected": {
              "const": "valid"
            }
          }
        },
        "then": {
          "required": [
            "digest"
          ]
        }
      }
    }
  }
}
