{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-mandate.org/conformance/v0/origin.schema.json",
  "title": "Public origin, htu and DPoP proof cases of the Home-Mandate Specification v0 (SPEC-v0 section 11.7 items 1 and 6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "section",
              "value",
              "expected",
              "why"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "section": {
                "const": "11.7"
              },
              "value": {
                "type": "string",
                "maxLength": 1024
              },
              "expected": {
                "enum": [
                  "valid",
                  "invalid"
                ]
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "section",
              "htu",
              "url",
              "expected",
              "why"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "section": {
                "const": "11.7"
              },
              "htu": {
                "type": "string",
                "maxLength": 1024
              },
              "url": {
                "type": "string",
                "maxLength": 1024
              },
              "expected": {
                "enum": [
                  "match",
                  "mismatch"
                ]
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "section",
              "proof",
              "request",
              "expected",
              "why"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "section": {
                "const": "11.7"
              },
              "proof": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "typ",
                  "alg",
                  "jkt",
                  "htm",
                  "htu",
                  "iat",
                  "jti"
                ],
                "properties": {
                  "typ": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "alg": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "jkt": {
                    "$ref": "#/$defs/thumbprint"
                  },
                  "htm": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "htu": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "iat": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "jti": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "ath": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "url",
                  "received"
                ],
                "properties": {
                  "method": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "received": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "access_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "bound_jkt": {
                    "$ref": "#/$defs/thumbprint"
                  },
                  "dpop_jkt": {
                    "$ref": "#/$defs/thumbprint"
                  }
                },
                "dependentRequired": {
                  "access_token": [
                    "bound_jkt"
                  ],
                  "bound_jkt": [
                    "access_token"
                  ]
                },
                "not": {
                  "required": [
                    "access_token",
                    "dpop_jkt"
                  ]
                }
              },
              "seen": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true
              },
              "started": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "expected": {
                "enum": [
                  "valid",
                  "invalid"
                ]
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "thumbprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    }
  }
}
