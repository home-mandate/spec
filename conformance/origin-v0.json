    {"id": "o39", "section": "11.7", "value": "https://a.0x7f000001", "expected": "invalid", "why": "the last label is 0x followed by hexadecimal digits: a URL parser reads the host as an IPv4 address"},
    {"id": "o40", "section": "11.7", "value": "https://x.0x7f.0x1", "expected": "invalid", "why": "the last label is 0x followed by a hexadecimal digit: a URL parser reads the host as an IPv4 address"},
    {"id": "o41", "section": "11.7", "value": "https://home.0x", "expected": "invalid", "why": "the last label is 0x alone, which a URL parser reads as the number 0"},
    {"id": "o42", "section": "11.7", "value": "https://home.0xg", "expected": "valid", "why": "0x followed by a letter that is no hexadecimal digit: not a number"},
    {"id": "o43", "section": "11.7", "value": "https://home.123-4", "expected": "invalid", "why": "the last label has no letter"},
    {"id": "h01", "section": "11.7", "htu": "https://home.example.net/mcp", "url": "https://home.example.net/mcp", "expected": "match", "why": "the same URL"},
