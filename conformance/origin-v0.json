{
  "description": "Public origins and the htu of DPoP proofs, SPEC-v0.md section 11.7 items 1 and 6. A case with value: whether the configured value is a public origin (valid or invalid): https://, a DNS name of at least two labels of lower-case letters, digits and hyphens that IDNA lookup maps to itself, the last label not all digits, no final dot, the port only if it is not 443, nothing after host and port. A case with htu and url: whether the htu of a proof matches the URL the implementation built from its public origin, both normalized as RFC 3986 sections 6.2.2 and 6.2.3 describe (case of scheme and host, percent-encoding, dot segments, default port, empty path) and without query and fragment (RFC 9449 section 4.3); a value that is not an absolute URL with a host, or has a broken percent-encoding, matches nothing.",
  "cases": [
    {"id": "o01", "section": "11.7", "value": "https://home.example.net", "expected": "valid", "why": "a DNS name of three labels"},
    {"id": "o02", "section": "11.7", "value": "https://hm.example.org:8443", "expected": "valid", "why": "a port other than 443"},
    {"id": "o03", "section": "11.7", "value": "https://xn--bcher-kva.example", "expected": "valid", "why": "an A-label"},
    {"id": "o04", "section": "11.7", "value": "https://k7q2xwmpd4hj3n6rt5vbyc2ezu.homes.example.net", "expected": "valid", "why": "a standard name of a relay"},
    {"id": "o05", "section": "11.7", "value": "https://1a.example", "expected": "valid", "why": "digits in a label that is not the last"},
    {"id": "o06", "section": "11.7", "value": "https://home.example.net:1", "expected": "valid", "why": "the lowest port"},
    {"id": "o07", "section": "11.7", "value": "https://home.example.net:65535", "expected": "valid", "why": "the highest port"},
    {"id": "o08", "section": "11.7", "value": "http://home.example.net", "expected": "invalid", "why": "the scheme http"},
    {"id": "o09", "section": "11.7", "value": "HTTPS://home.example.net", "expected": "invalid", "why": "the scheme in upper case"},
    {"id": "o10", "section": "11.7", "value": "https://Home.example.net", "expected": "invalid", "why": "the host in upper case"},
    {"id": "o11", "section": "11.7", "value": "https://home.example.net/", "expected": "invalid", "why": "a path of a single slash"},
    {"id": "o12", "section": "11.7", "value": "https://home.example.net/mcp", "expected": "invalid", "why": "a path"},
    {"id": "o13", "section": "11.7", "value": "https://home.example.net?x=1", "expected": "invalid", "why": "a query"},
    {"id": "o14", "section": "11.7", "value": "https://home.example.net#top", "expected": "invalid", "why": "a fragment"},
    {"id": "o15", "section": "11.7", "value": "https://admin@home.example.net", "expected": "invalid", "why": "userinfo"},
    {"id": "o16", "section": "11.7", "value": "https://home.example.net:443", "expected": "invalid", "why": "the default port written out"},
    {"id": "o17", "section": "11.7", "value": "https://home.example.net:", "expected": "invalid", "why": "an empty port"},
    {"id": "o18", "section": "11.7", "value": "https://home.example.net:08443", "expected": "invalid", "why": "a port with a leading zero"},
    {"id": "o19", "section": "11.7", "value": "https://home.example.net:65536", "expected": "invalid", "why": "a port out of range"},
    {"id": "o20", "section": "11.7", "value": "https://home.example.net:0", "expected": "invalid", "why": "port 0"},
    {"id": "o21", "section": "11.7", "value": "https://home.example.net.", "expected": "invalid", "why": "a final dot"},
    {"id": "o22", "section": "11.7", "value": "https://localhost", "expected": "invalid", "why": "a single label"},
    {"id": "o23", "section": "11.7", "value": "https://192.0.2.1", "expected": "invalid", "why": "an IPv4 address"},
    {"id": "o24", "section": "11.7", "value": "https://[2001:db8::1]", "expected": "invalid", "why": "an IPv6 address"},
    {"id": "o25", "section": "11.7", "value": "https://bücher.example", "expected": "invalid", "why": "a U-label instead of its A-label"},
    {"id": "o26", "section": "11.7", "value": "https://xn--a.example", "expected": "invalid", "why": "an A-label that does not decode"},
    {"id": "o27", "section": "11.7", "value": "https://-home.example.net", "expected": "invalid", "why": "a label that begins with a hyphen"},
    {"id": "o28", "section": "11.7", "value": "https://home-.example.net", "expected": "invalid", "why": "a label that ends with a hyphen"},
    {"id": "o29", "section": "11.7", "value": "https://home_1.example.net", "expected": "invalid", "why": "an underscore"},
    {"id": "o30", "section": "11.7", "value": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "expected": "invalid", "why": "a label of 64 characters"},
    {"id": "o31", "section": "11.7", "value": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "expected": "invalid", "why": "a host longer than 253 characters"},
    {"id": "o32", "section": "11.7", "value": "https://home.example.123", "expected": "invalid", "why": "a last label of digits only"},
    {"id": "o33", "section": "11.7", "value": " https://home.example.net", "expected": "invalid", "why": "white space before the scheme"},
    {"id": "o34", "section": "11.7", "value": "https://home..example.net", "expected": "invalid", "why": "an empty label"},
    {"id": "o35", "section": "11.7", "value": "", "expected": "invalid", "why": "empty"},
    {"id": "o36", "section": "11.7", "value": "https://home.example.net\\mcp", "expected": "invalid", "why": "a backslash, which browsers read as a slash"},
    {"id": "o37", "section": "11.7", "value": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "expected": "valid", "why": "a label of 63 characters"},
    {"id": "o38", "section": "11.7", "value": "https://home.example.net:8443/", "expected": "invalid", "why": "a port and a single slash"},
    {"id": "h01", "section": "11.7", "htu": "https://home.example.net/mcp", "url": "https://home.example.net/mcp", "expected": "match", "why": "the same URL"},
    {"id": "h02", "section": "11.7", "htu": "HTTPS://Home.Example.NET/mcp", "url": "https://home.example.net/mcp", "expected": "match", "why": "scheme and host in another case"},
    {"id": "h03", "section": "11.7", "htu": "https://home.example.net:443/mcp", "url": "https://home.example.net/mcp", "expected": "match", "why": "the default port written out"},
    {"id": "h04", "section": "11.7", "htu": "https://home.example.net/mcp?session=1#x", "url": "https://home.example.net/mcp", "expected": "match", "why": "query and fragment are ignored"},
    {"id": "h05", "section": "11.7", "htu": "https://home.example.net/%7Emcp", "url": "https://home.example.net/~mcp", "expected": "match", "why": "a percent-encoded unreserved character"},
    {"id": "h06", "section": "11.7", "htu": "https://home.example.net/a%2fb", "url": "https://home.example.net/a%2Fb", "expected": "match", "why": "the case of percent-encoding"},
    {"id": "h07", "section": "11.7", "htu": "https://home.example.net/x/../mcp", "url": "https://home.example.net/mcp", "expected": "match", "why": "dot segments"},
    {"id": "h08", "section": "11.7", "htu": "https://home.example.net", "url": "https://home.example.net/", "expected": "match", "why": "an empty path is the path /"},
    {"id": "h09", "section": "11.7", "htu": "https://hm.example.org:8443/token", "url": "https://hm.example.org:8443/token", "expected": "match", "why": "a port other than 443"},
    {"id": "h10", "section": "11.7", "htu": "https://other.example.net/mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "another host"},
    {"id": "h11", "section": "11.7", "htu": "http://home.example.net/mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "another scheme"},
    {"id": "h12", "section": "11.7", "htu": "https://home.example.net:8443/mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "another port"},
    {"id": "h13", "section": "11.7", "htu": "https://home.example.net/mcp/", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "a final slash in the path"},
    {"id": "h14", "section": "11.7", "htu": "https://home.example.net/MCP", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "the path is compared with regard to case"},
    {"id": "h15", "section": "11.7", "htu": "https://home.example.net/a%2Fb", "url": "https://home.example.net/a/b", "expected": "mismatch", "why": "an encoded slash is not a slash"},
    {"id": "h16", "section": "11.7", "htu": "https://home.example.net.evil.example/mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "a host that only begins with the host"},
    {"id": "h17", "section": "11.7", "htu": "https://admin@home.example.net/mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "userinfo"},
    {"id": "h18", "section": "11.7", "htu": "/mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "a relative reference"},
    {"id": "h19", "section": "11.7", "htu": "https://home.example.net./mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "a final dot is a different host for RFC 3986"},
    {"id": "h20", "section": "11.7", "htu": "https://home.example.net/mcp%", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "a broken percent-encoding matches nothing"},
    {"id": "h21", "section": "11.7", "htu": "https://home.example.net:80/mcp", "url": "https://home.example.net/mcp", "expected": "mismatch", "why": "the default port of http is not that of https"}
  ]
}
