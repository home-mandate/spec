    {"id": "p12", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "none", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780272000, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "invalid", "why": "a proof without a signature"},
