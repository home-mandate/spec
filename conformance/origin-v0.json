    {"id": "p01", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780272000, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "valid", "why": "a request to a resource with a bound token: method, URL, time, ath and key all match"},
    {"id": "p02", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "GET", "htu": "https://home.example.net/mcp", "iat": 1780272000, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "invalid", "why": "htm names another method than the request's"},
    {"id": "p03", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "post", "htu": "https://home.example.net/mcp", "iat": 1780272000, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "invalid", "why": "htm is compared exactly: methods are case-sensitive"},
    {"id": "p04", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780272000, "jti": "e1j3V_bKic8-LAEB"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "invalid", "why": "a request with an access token needs ath"},
    {"id": "p05", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780272000, "jti": "e1j3V_bKic8-LAEB", "ath": "GDQRhYQJOQ2LspH43Iv7MxdlgLfKcnpz9RD3RejFzH8"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "invalid", "why": "ath is the hash of another token: a proof captured for one token is not valid with another"},
    {"id": "p06", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780271940, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "valid", "why": "iat 60 seconds before the request was received is still inside the window"},
    {"id": "p07", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780271939, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "invalid", "why": "iat more than 60 seconds before the request was received"},
    {"id": "p08", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780272010, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "valid", "why": "iat 10 seconds after the request was received is still inside the window"},
    {"id": "p09", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780272011, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "expected": "invalid", "why": "iat more than 10 seconds after the request was received"},
    {"id": "p10", "section": "11.7", "proof": {"typ": "dpop+jwt", "alg": "ES256", "jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU", "htm": "POST", "htu": "https://home.example.net/mcp", "iat": 1780272000, "jti": "e1j3V_bKic8-LAEB", "ath": "bJYTDxMKsNbRWDl-JNK8wcml5zrggfbpg_HHtUXSSkw"}, "request": {"method": "POST", "url": "https://home.example.net/mcp", "received": 1780272000, "access_token": "2YotnFZFEjr1zCsicMWpAA", "bound_jkt": "FTZlO1KXejfLpuvpTx0LiqxE4_uLD_LKikOE3QilzjU"}, "seen": ["e1j3V_bKic8-LAEB"], "expected": "invalid", "why": "a jti accepted before within the window is a replay"},
